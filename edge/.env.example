# Settings for the release publisher (npm run release). The Worker reads none of these: it has only its R2 binding.
# Copy to .env.staging, fill it in, and keep it out of Git and out of chats and tickets:
#
#   cp .env.example .env.staging && chmod 600 .env.staging
#   npm run release:staging -- status    # release:staging loads .env.staging
#
# These are deliberately not the application's S3_* settings. The publisher never reads the private bucket's
# configuration, and it refuses any bucket whose name does not contain "public-demo".

# R2's S3 endpoint for the account: https://<account-id>.r2.cloudflarestorage.com
PUBLIC_DEMO_S3_ENDPOINT=
# The dedicated bucket the staging Worker is bound to in wrangler.jsonc.
PUBLIC_DEMO_S3_BUCKET=frameflow-public-demo-staging
# An R2 API token with "Object Read & Write", limited to that one bucket.
PUBLIC_DEMO_S3_ACCESS_KEY_ID=
PUBLIC_DEMO_S3_SECRET_ACCESS_KEY=
# PUBLIC_DEMO_S3_REGION=auto
# PUBLIC_DEMO_S3_FORCE_PATH_STYLE=true
