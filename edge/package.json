{
  "name": "frameflow-edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public demo delivery for Frameflow: a Cloudflare Worker in front of a dedicated R2 bucket, and the release publisher that fills it.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "build": "wrangler deploy --dry-run --outdir .build",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "release": "tsx src/publisher/cli.ts",
    "release:staging": "tsx --env-file=.env.staging src/publisher/cli.ts",
    "demo:local": "tsx scripts/local-demo.ts",
    "edge:check": "tsx scripts/edge-check.ts",
    "deploy:staging": "wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "24.13.3",
    "hls.js": "1.7.3",
    "miniflare": "5.20261110.0-beta",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
