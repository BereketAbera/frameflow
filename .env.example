# Get this from Hatchet Cloud or your self-hosted Hatchet instance.
HATCHET_CLIENT_TOKEN=

PORT=3000
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/output
MAX_UPLOAD_BYTES=524288000
RECONCILIATION_STALE_MINUTES=15
MAX_CONCURRENT_ENCODES=2
WORKER_TEMP_DIR=./.worker-tmp
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=video-processing-poc
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_UPLOAD_TTL_SECONDS=600

# Optional for self-hosted Hatchet. The SDK defaults to Hatchet Cloud.
# HATCHET_CLIENT_HOST_PORT=127.0.0.1:7077
# HATCHET_CLIENT_TLS_STRATEGY=none

# Development-only deterministic retry demonstration.
# FORCE_720P_FAILURE_ONCE=true
