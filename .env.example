# Get this from Hatchet Cloud or your self-hosted Hatchet instance.
HATCHET_CLIENT_TOKEN=

# Fastify backend port and bind address. Next.js runs on 3000; containers set HOST=0.0.0.0.
PORT=4000
# HOST=127.0.0.1
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/output
MAX_UPLOAD_BYTES=524288000
RECONCILIATION_STALE_MINUTES=15
MAX_CONCURRENT_ENCODES=2
WORKER_TEMP_DIR=./.worker-tmp
# Empty or unset means this local MinIO. For AWS S3, the regional endpoint, such as
# https://s3.eu-west-1.amazonaws.com, with S3_FORCE_PATH_STYLE=false.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=frameflow
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_UPLOAD_TTL_SECONDS=600
# Optional bare public origin (no path) that browser upload URLs are signed for;
# the API and worker keep calling S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://frameflow.example.com
# Override these host ports if another local MinIO already uses 9000/9001.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STATUS_CALLBACK_BASE_URL=http://127.0.0.1:4000
WORKER_CALLBACK_SECRET=development-worker-secret
CLEANUP_STALE_HOURS=24

# Optional. Configure both to enable Supabase email/password authentication.
# Without these values the app runs as a single local development user.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional authentication mode. Unset keeps the behaviour above; AUTH_MODE=supabase
# requires the Supabase values. AUTH_MODE=owner makes the site read-only for visitors
# and admits only the holder of the owner access key (see "Owner access key" in the
# README); it cannot be combined with Supabase.
# AUTH_MODE=owner
# OWNER_TOKEN_SHA256=<64-character hex SHA-256 of the access key>
# OWNER_SESSION_SECRET=<at least 32 random characters>
# OWNER_USER_ID=local-development
# OWNER_SESSION_MAX_AGE_SECONDS=43200

# Optional worker limits for a shared server.
# FRAMEFLOW_WORKER_SLOTS=2
# FRAMEFLOW_MAX_CONCURRENT_VIDEOS=1
# FRAMEFLOW_SCHEDULE_TIMEOUT=12h
# FRAMEFLOW_REGISTER_LEGACY_WORKFLOW=true
# FFMPEG_THREADS=2
# FFMPEG_LOG_LEVEL=error

# Next.js build-time settings, read by next dev and next build.
# API_ORIGIN=http://127.0.0.1:4000
# NEXT_OUTPUT=standalone

# Optional for self-hosted Hatchet. The SDK defaults to Hatchet Cloud.
# HATCHET_CLIENT_HOST_PORT=127.0.0.1:7077
# HATCHET_CLIENT_TLS_STRATEGY=none

# Development-only deterministic retry demonstration.
# FORCE_720P_FAILURE_ONCE=true
